{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@reimagine intake brief",
  "type": "object",
  "required": ["task", "photo", "audience"],
  "properties": {
    "task": {"type": "string", "description": "One sentence: what is being re-imagined and why"},
    "photo": {
      "type": "object",
      "required": ["present"],
      "properties": {
        "present": {"type": "boolean"},
        "type": {"type": "string", "enum": ["photo", "screenshot", "render", "sketch", "site-satellite", "mesh", "none", "unknown"]},
        "source": {"type": "string", "enum": ["own", "licensed", "cleared", "internet-untraced", "none", "unknown"]},
        "creator": {"type": "string"},
        "licence": {"type": "string"},
        "url": {"type": "string"},
        "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "watermark_present": {"type": "boolean"},
        "quality_notes": {"type": "string", "description": "screenshot chrome, compression, resolution — questionnaire mode records user assertions as [O] user-described"}
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["plan", "elevation", "section", "eye-level", "aerial", "perspective", "unknown"]},
        "camera_locked": {"type": "boolean"},
        "documents": {"type": "string", "description": "dimensions/model revision ONLY if from actual documents"}
      }
    },
    "locked": {"type": "array", "items": {"type": "object", "required": ["feature", "basis"], "properties": {"feature": {"type": "string"}, "basis": {"type": "string", "enum": ["measured", "visual-cue", "user-described"]}}},
      "description": "Preserve-list raw material; first item SHOULD be the projection/view invariant"},
    "allowed_change": {"type": "string", "description": "ONE bounded change — material | facade zone | lighting | vegetation | massing option"},
    "references": {"type": "array", "items": {"type": "object", "required": ["role", "origin"], "properties": {"role": {"type": "string", "enum": ["A-geometry-base", "B-style-only", "C-edit-area"]}, "origin": {"type": "string"}}}},
    "audience": {"type": "string", "enum": ["internal mood study", "client concept", "public", "approval package"]},
    "context": {
      "type": "object",
      "properties": {
        "school": {"type": "boolean", "description": "any coursework/competition context → disclosure gate"},
        "deadline": {"type": "string"},
        "provider_access": {"type": "string"}
      }
    }
  }
}
